{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "york": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "York LiteLLM",
      "options": {
        "baseURL": "https://llm.york.cuny.edu/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "York-Coder": {
          "name": "York Coder"
        }
      }
    }
  },

  "model": "york/York-Coder",

  "instructions": ["AGENTS.md", "docs/*.md"],

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "npx prisma *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm *": "deny",
      "git push*": "deny"
    },
    "webfetch": "ask"
  }
}

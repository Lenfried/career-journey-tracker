# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every variable here is validated by src/lib/env.ts at boot, so a typo fails
# loudly at startup instead of mysteriously at 4pm.

# --- Database --------------------------------------------------------------
# Matches docker/docker-compose.dev.yml. Change the password for production.
DATABASE_URL="postgresql://cjt:devpassword@localhost:5432/career_journey_tracker?schema=public"

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- York LiteLLM proxy ----------------------------------------------------
# Student data must never leave campus infrastructure. This is the only
# model endpoint the app is allowed to call.
LITELLM_BASE_URL="https://llm.york.cuny.edu/v1"
LITELLM_API_KEY=""
LITELLM_MODEL="York-Coder"

# --- App -------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="debug"
